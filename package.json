{
  "name": "intellizen-workspace",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "build": "turbo run build",
    "watch": "turbo watch build:dev",
    "clean": "turbo run clean",
    "package": "turbo run package",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "test": "pnpm build && vitest --typecheck",
    "test:update": "vitest --typecheck -u"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.4.1",
    "@types/node": "^24.7.1",
    "eslint": "^9.37.0",
    "pnpm": "^10.18.2",
    "shx": "^0.4.0",
    "tsdown": "^0.15.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
