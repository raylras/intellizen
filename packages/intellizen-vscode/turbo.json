{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["copy", "^build"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["copy:dev", "^build:dev"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "copy": {
      "dependsOn": ["intellizen-zenscript#langium:generate"],
      "inputs": ["../intellizen-zenscript/syntaxes"],
      "outputs": ["syntaxes/**"]
    },
    "copy:dev": {
      "dependsOn": ["intellizen-zenscript#langium:generate:dev"],
      "inputs": ["../intellizen-zenscript/syntaxes"],
      "outputs": ["syntaxes/**"],
      "cache": false
    },
    "package": {
      "dependsOn": ["^build"],
      "outputs": ["./*.vsix"]
    }
  }
}
