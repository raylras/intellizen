{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "package": {
      "dependsOn": ["^build"],
      "outputs": ["*.vsix"],
      "cache": false
    }
  }
}
