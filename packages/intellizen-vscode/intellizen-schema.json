{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "srcRoots": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "format": "uri-reference"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "$ref": {
                "type": "string",
                "format": "json-pointer"
              }
            },
            "required": ["$ref"]
          }
        ]
      },
      "minItems": 1
    },
    "probezs": {
      "type": "object",
      "properties": {
        "dumpDir": {
          "type": "string",
          "format": "uri-reference"
        },
        "rpcSocketPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    }
  },
  "required": ["srcRoots"],
  "additionalProperties": true
}
