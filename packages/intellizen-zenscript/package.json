{
  "name": "intellizen-zenscript",
  "type": "module",
  "version": "0.0.1",
  "author": "intellizen-dev",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "watch": "pnpm clean && concurrently \"pnpm langium:generate:watch\" \"wait-on src/generated && pnpm build:watch\"",
    "build": "tsup --minify",
    "build:watch": "tsup --sourcemap --watch",
    "langium:generate": "langium generate --mode production",
    "langium:generate:watch": "langium generate --mode development --watch",
    "clean": "shx rm -rf dist syntaxes src/generated"
  },
  "dependencies": {
    "immutable": "^5.1.3",
    "langium": "^4.0.0"
  },
  "devDependencies": {
    "langium-cli": "^4.0.0"
  }
}
