{
  "name": "intellizen-zenscript",
  "type": "module",
  "version": "0.0.1",
  "author": "intellizen-dev",
  "exports": {
    ".": {
      "sources": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "watch": "concurrently \"langium generate --watch\" \"wait-on src/generated && tsup --watch\"",
    "build": "tsup",
    "langium:generate": "langium generate",
    "clean": "shx rm -rf dist syntaxes src/generated"
  },
  "dependencies": {
    "immutable": "^5.1.3",
    "langium": "^4.0.0"
  },
  "devDependencies": {
    "langium-cli": "^4.0.0"
  }
}
