{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/intellizen-vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/*/dist/**/*.js"
      ],
      "trace": true,
      "autoAttachChildProcesses": true
    },
    {
      "name": "Attach to Extension",
      "type": "node",
      "port": 6009,
      "request": "attach",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
